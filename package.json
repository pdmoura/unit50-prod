{
  "name": "unit50-prod",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts --dev\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "start:dev": "node dist-server/server/index.js --dev",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@supabase/supabase-js": "^2.117.2",
    "@turf/point-on-feature": "^7.3.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "6.11.2",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}

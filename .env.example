# Production database, used by "npm start". For Supabase, use the "Session pooler"
# string from the dashboard's Connect button.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Development database, used by "npm run dev", "npm run start:dev" and the tests
# (tests use "<database>_test" on this server). Start it with "npm run db:up".
DATABASE_URL_DEV=postgres://unit50:unit50@127.0.0.1:54350/unit50

# Sign-in (Supabase Auth). Both values are public; find them in the Supabase
# dashboard under Project Settings > API Keys. Without them the app has no
# sign-in and only answers requests from this computer.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Property photos (optional). A restricted key with the Manager role on the folder;
# see scripts/cloudinary-folder-access.mjs. Never prefix the secret with VITE_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=unit50-uploads

# Street View coverage check (scripts/street-view-check.ts only; the app does
# not read these). A Google Cloud API key restricted to the "Street View Static
# API"; the URL signing secret is optional. Never prefix either with VITE_.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SIGNING_SECRET=

# PORT=3000
